# The shop's Caddy configuration, as installed in /etc/caddy/Caddyfile on the server.
# After changing it there:  caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
# (a reload does not drop connections).
#
# Do not limit how many /_next/image requests reach the app at once (max_conns_per_host on a
# separate reverse_proxy for that path). It was tried on 2026-11-18 with a limit of one: pages
# stayed fast, but every photo on the site waited in a single line behind the photos still being
# resized, and with several visitors the line grew until photos took 20 s. It was removed the
# same hour.

nordiva.com.ua {
	reverse_proxy localhost:3000
}

# One address for the shop: www goes to the main one (the canonical of every page), path and
# query kept. Google sign-in returns to www (NEXTAUTH_URL on the server); without this a
# sign-in started on nordiva.com.ua lost its state cookie on the way back and failed
# ("State cookie was missing"). Since 2026-11-19.
www.nordiva.com.ua {
	redir https://nordiva.com.ua{uri} permanent
}

assets.nordiva.com.ua {
	reverse_proxy localhost:9000
}
